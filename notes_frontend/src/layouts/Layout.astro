---
import ThemeToggle from '../components/ThemeToggle.astro';

type Props = {
	title?: string;
};

const { title = 'Notes' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta
			name="description"
			content="A simple notes app with local-first storage. Create, edit, and manage notes."
		/>
	</head>

	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<!-- Optional: keep the existing theme toggle (light/dark) -->
		<ThemeToggle />

		<slot />
	</body>
</html>

<style>
	:root {
		/* Ocean Professional (Light) */
		--op-primary: #2563eb; /* blue */
		--op-secondary: #f59e0b; /* amber */
		--op-bg: #f9fafb; /* background */
		--op-surface: #ffffff; /* surface */
		--op-text: #111827; /* text */
		--op-text-muted: #4b5563; /* subtle text */
		--op-border: rgba(17, 24, 39, 0.12);
		--op-shadow: 0 10px 30px rgba(17, 24, 39, 0.08);
		--op-shadow-sm: 0 6px 16px rgba(17, 24, 39, 0.08);
		--op-radius: 14px;

		/* Focus */
		--op-focus: 0 0 0 3px rgba(37, 99, 235, 0.25);

		/* Gradients */
		--op-grad-soft: radial-gradient(
				800px 500px at 10% 0%,
				rgba(37, 99, 235, 0.12),
				transparent 60%
			),
			radial-gradient(700px 450px at 90% 10%, rgba(245, 158, 11, 0.12), transparent 55%);

		/* Typography */
		--op-font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial,
			'Apple Color Emoji', 'Segoe UI Emoji';
	}

	/* Dark theme tokens (hooked to existing ThemeToggle behavior) */
	body.dark-theme {
		--op-bg: #0b1220;
		--op-surface: rgba(17, 24, 39, 0.72);
		--op-text: #f9fafb;
		--op-text-muted: #cbd5e1;
		--op-border: rgba(255, 255, 255, 0.12);
		--op-shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
		--op-shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.35);
		--op-focus: 0 0 0 3px rgba(37, 99, 235, 0.35);

		--op-grad-soft: radial-gradient(
				900px 520px at 10% 0%,
				rgba(37, 99, 235, 0.18),
				transparent 60%
			),
			radial-gradient(700px 450px at 90% 10%, rgba(245, 158, 11, 0.12), transparent 55%);
	}

	html,
	body {
		height: 100%;
	}

	body {
		margin: 0;
		font-family: var(--op-font);
		color: var(--op-text);
		background: var(--op-bg);
		background-image: var(--op-grad-soft);
		background-attachment: fixed;
		line-height: 1.4;
	}

	/* General accessibility */
	.skip-link {
		position: absolute;
		top: 8px;
		left: 8px;
		padding: 10px 12px;
		border-radius: 10px;
		background: var(--op-surface);
		border: 1px solid var(--op-border);
		box-shadow: var(--op-shadow-sm);
		color: var(--op-text);
		text-decoration: none;
		transform: translateY(-140%);
		transition: transform 0.2s ease;
		z-index: 9999;
	}

	.skip-link:focus {
		transform: translateY(0);
		outline: none;
		box-shadow: var(--op-shadow-sm), var(--op-focus);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(:focus-visible) {
		outline: none;
		box-shadow: var(--op-focus);
		border-radius: 10px;
	}
</style>
